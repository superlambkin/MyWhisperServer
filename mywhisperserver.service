[Unit]
Description=MyWhisperServer (Whisper ASR + Dashboard)
After=network.target
Wants=network-online.target

[Service]
# 替换为你的实际路径（示例：/home/USER/whisper_server）
WorkingDirectory=/home/USER/whisper_server
ExecStart=/bin/bash /home/USER/whisper_server/start_all.sh
Restart=always
RestartSec=5
# 使用你创建服务时的用户（建议不要用 root）
User=USER
Group=USER

# 环境变量（GPU 模式默认 float16；CPU 模式改为 int8）
Environment=PYTHONUNBUFFERED=1
Environment=WHISPER_MODEL=medium
# Environment=WHISPER_COMPUTE_TYPE=int8

[Install]
WantedBy=multi-user.target
